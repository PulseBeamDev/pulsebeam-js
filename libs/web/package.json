{
  "name": "@pulsebeam/web",
  "version": "0.0.1",
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "source": "./src/lib.ts",
      "types": "./dist/src/lib.d.ts",
      "default": "./dist/lib.js"
    }
  },
  "scripts": {
    "dev": "vite build --watch",
    "dev:local": "vite build --watch",
    "prepare": "tsc && vite build",
    "preview": "vite preview",
    "test:serve": "vite",
    "test:sfu:clean": "podman rm -f sfu-test > /dev/null 2>&1 || true",
    "test:e2e": "pnpm test:sfu:clean && playwright test --config=tests/playwright.config.ts --grep-invert \"QoE\"",
    "test:e2e:qoe": "pnpm test:sfu:clean && playwright test --config=tests/playwright.config.ts qoe.",
    "test:e2e:qoe:flaky": "pnpm test:sfu:clean && RUN_FLAKY=1 playwright test --config=tests/playwright.config.ts qoe. --project=chromium-flaky",
    "test:e2e:ui": "playwright test --config=tests/playwright.config.ts --ui",
    "test:e2e:report": "playwright show-report playwright-report",
    "lint": "eslint tests"
  },
  "dependencies": {
    "@pulsebeam/core": "workspace:*",
    "webrtc-adapter": "^9.0.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/node": "^25.2.3",
    "eslint": "^9.39.1",
    "fast-check": "^3.23.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.4",
    "vite-plugin-dts": "^4.5.4"
  }
}
